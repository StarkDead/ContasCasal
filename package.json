{
  "name": "casa-em-dia",
  "version": "1.0.0",
  "description": "Finanças da casa para o casal",
  "author": "Casa em Dia",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "br.casaemdia.app",
    "productName": "Casa em Dia",
    "files": [
      "main.js",
      "preload.js",
      "ui/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Casa-em-Dia-Instalador.exe",
      "shortcutName": "Casa em Dia"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "StarkDead",
        "repo": "ContasCasal",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "xlsx": "0.18.5"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}